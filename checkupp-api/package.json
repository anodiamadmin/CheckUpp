{
  "name": "checkupp-api",
  "packageManager": "yarn@4.11.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:once": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "migrate:users": "tsx scripts/migrate-users.ts",
    "migrate:wallet": "tsx scripts/migrate-wallet.ts",
    "migrate:pregnancy": "tsx scripts/migrate-pregnancy.ts",
    "migrate:screenings": "tsx scripts/migrate-screenings.ts",
    "migrate:feedback": "tsx scripts/migrate-feedback.ts",
    "migrate:verify": "tsx scripts/verify-migration.ts",
    "seed:clinician-login": "tsx scripts/seed-clinician-login.ts",
    "migrate:all": "yarn migrate:users && yarn migrate:wallet && yarn migrate:pregnancy && yarn migrate:screenings && yarn migrate:feedback && yarn migrate:verify"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.0.2",
    "morgan": "^1.10.1",
    "node-appwrite": "^22.1.3",
    "pg": "^8.20.0",
    "prisma": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
