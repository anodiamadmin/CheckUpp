NODE_ENV=development
PORT=3090
API_PREFIX=/api/v1

# Use encoded special characters if needed. Example password c0l!nm@rk => c0l%21nm%40rk
# For Neon in production, prefer sslmode=verify-full.
DATABASE_URL=postgresql://colinmarkl68:c0l%21nm%40rk@localhost:5432/checkupp-db

# Auth mode: jwt for the real backend auth flow. dev only accepts local x-user-* headers.
AUTH_MODE=jwt
JWT_SECRET=change-me-with-openssl-rand-hex-32
REFRESH_JWT_SECRET=change-me-with-a-different-openssl-rand-hex-32
ACCESS_TOKEN_TTL_MS=3600000
REFRESH_TOKEN_TTL_MS=2592000000
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Set true only for controlled admin tooling/dev seed flows. Signup otherwise creates PATIENT users.
AUTH_ALLOW_ROLE_SIGNUP=false

# Auth emails. Use EMAIL_DELIVERY=log for local development.
# Use EMAIL_DELIVERY=resend in Railway/free cloud environments where SMTP is blocked.
EMAIL_DELIVERY=log
EMAIL_FROM=Checkupp <no-reply@checkupp.local>
RESEND_API_KEY=your-resend-api-key
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=15000
WEB_APP_URL=http://localhost:3000
MOBILE_APP_URL=healthpassport://
FRONTEND_URL=http://localhost:8081
# Brevo example: smtp-relay.brevo.com. SMTP_* is used only when EMAIL_DELIVERY=smtp.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Defaults to IPv4 to avoid broken IPv6 SMTP routes on some networks. Use 0 for OS default.
SMTP_FAMILY=4
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_READ_TIMEOUT_MS=15000
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key

# Comma-separated OAuth client IDs accepted by backend social auth.
GOOGLE_OAUTH_CLIENT_IDS=your_google_web_client_id,your_google_ios_client_id,your_google_android_client_id
APPLE_OAUTH_CLIENT_IDS=com.app.healthpassport

# Comma separated list for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Request controls
REQUEST_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400

# Prisma logging
PRISMA_LOG_QUERIES=false

# Migration retry tuning (useful for cloud DB timeouts)
MIGRATION_DB_MAX_ATTEMPTS=8
MIGRATION_DB_RETRY_BASE_MS=1000
MIGRATION_DB_RETRY_MAX_MS=12000
