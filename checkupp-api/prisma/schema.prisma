generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(uuid())
  firebaseUid               String?                    @unique
  email                     String                     @unique
  passwordHash              String?
  emailVerified             Boolean                    @default(false)
  role                      UserRole                   @default(PATIENT)
  name                      String
  avatarUrl                 String?
  phoneNumber               String?
  gender                    Gender                     @default(UNKNOWN)
  dob                       DateTime?
  isDeleted                 Boolean                    @default(false)
  lastLoginAt               DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  authSessions              AuthSession[]
  socialAccounts            SocialAccount[]
  authVerificationCodes     AuthVerificationCode[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  assignedCareTasks         CareTask[]                  @relation("CareTaskAssignedTo")
  cancerScreeningSnapshot   CancerScreeningSnapshot?
  clinicianProfile          ClinicianProfile?
  consentsAsPatient         ConsentGrant[]             @relation("PatientConsents")
  createdCareTasks          CareTask[]                  @relation("CareTaskCreatedBy")
  createdCohorts            PatientCohort[]             @relation("CohortCreatedBy")
  feedbackEntries           FeedbackEntry[]
  healthScreeningSnapshot   HealthScreeningSnapshot?
  organizationPermissions   OrganizationUserPermission[]
  patientCareTasks          CareTask[]                  @relation("CareTaskPatient")
  patientCohortMemberships  PatientCohortMember[]       @relation("CohortMemberPatient")
  patientLinksAsPatient     PatientLink[]              @relation("PatientLinks")
  patientMessages           PatientMessage[]            @relation("PatientMessages")
  patientReminderRequests   PatientReminderRequest[]    @relation("PatientReminderRequests")
  pregnancyPlan             PregnancyPlan?
  screeningDueItems         ScreeningDueItem[]
  screeningImportBatches    ScreeningImportBatch[]
  screeningPlans            ScreeningPlan[]
  enteredScreeningRecords   ScreeningRecord[]          @relation("ScreeningRecordEnteredBy")
  screeningRecords          ScreeningRecord[]          @relation("ScreeningRecordOwner")
  walletDocuments           WalletDocument[]
  screeningPracticeContacts ScreeningPracticeContact[]
}

model SocialAccount {
  id             String             @id @default(uuid())
  userId         String
  provider       SocialAuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model AuthSession {
  id               String   @id @default(uuid())
  userId           String
  accessTokenHash  String   @unique
  refreshTokenHash String   @unique
  expiresAt        DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model AuthVerificationCode {
  id        String                   @id @default(uuid())
  userId    String
  contact   String
  codeHash  String
  type      AuthVerificationCodeType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contact, type, expiresAt])
  @@index([userId, type])
}

model Organization {
  id          String                       @id @default(uuid())
  name        String
  slug        String                       @unique
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  careTasks   CareTask[]
  clinicians  ClinicianProfile[]
  cohorts     PatientCohort[]
  permissions OrganizationUserPermission[]
}

model ClinicianProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  organizationId String?
  licenseNumber  String?
  specialty      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  careTasks      CareTask[]     @relation("CareTaskClinician")
  consents       ConsentGrant[] @relation("ClinicianConsents")
  cohorts        PatientCohort[]
  documentReviews WalletDocumentReview[]
  messages       PatientMessage[]
  patientLinks   PatientLink[]  @relation("ClinicianPatientLinks")
  reminderRequests PatientReminderRequest[]
  savedViews     ClinicianSavedView[]

  @@index([organizationId])
}

model ClinicianSavedView {
  id          String           @id @default(uuid())
  clinicianId String
  name        String
  viewType    String           @default("PATIENT_WORKLIST")
  filters     Json
  columns     Json?
  sort        Json?
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)

  @@index([clinicianId, viewType])
}

model CareTask {
  id               String            @id @default(uuid())
  patientId        String
  clinicianId      String
  organizationId   String?
  title            String
  description      String?
  category         String            @default("GENERAL")
  priority         String            @default("MEDIUM")
  status           String            @default("OPEN")
  source           String            @default("CLINICIAN")
  dueAt            DateTime?
  completedAt      DateTime?
  createdByUserId  String?
  assignedToUserId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assignedTo        User?             @relation("CareTaskAssignedTo", fields: [assignedToUserId], references: [id])
  clinician         ClinicianProfile  @relation("CareTaskClinician", fields: [clinicianId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("CareTaskCreatedBy", fields: [createdByUserId], references: [id])
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  patient           User              @relation("CareTaskPatient", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status, dueAt])
  @@index([clinicianId, status, dueAt])
  @@index([organizationId, status])
}

model PatientMessage {
  id           String           @id @default(uuid())
  patientId    String
  clinicianId  String
  senderUserId String?
  body         String
  channel      String           @default("IN_APP")
  status       String           @default("SENT")
  readAt       DateTime?
  createdAt    DateTime         @default(now())
  clinician    ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  patient      User             @relation("PatientMessages", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([clinicianId, createdAt])
}

model PatientReminderRequest {
  id           String           @id @default(uuid())
  patientId    String
  clinicianId  String
  title        String
  description  String?
  dueAt        DateTime?
  recurrence   String?
  status       String           @default("REQUESTED")
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  clinician    ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  patient      User             @relation("PatientReminderRequests", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status, dueAt])
  @@index([clinicianId, status, dueAt])
}

model WalletDocumentReview {
  id               String           @id @default(uuid())
  walletDocumentId String
  clinicianId      String
  status           String           @default("PENDING")
  note             String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  clinician        ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  walletDocument   WalletDocument   @relation(fields: [walletDocumentId], references: [id], onDelete: Cascade)

  @@unique([walletDocumentId, clinicianId])
  @@index([clinicianId, status])
}

model PatientCohort {
  id              String                @id @default(uuid())
  organizationId  String?
  clinicianId     String?
  name            String
  description     String?
  filters         Json?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  clinician       ClinicianProfile?     @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation("CohortCreatedBy", fields: [createdByUserId], references: [id])
  members         PatientCohortMember[]
  organization    Organization?         @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([clinicianId])
}

model PatientCohortMember {
  id        String        @id @default(uuid())
  cohortId  String
  patientId String
  addedAt   DateTime      @default(now())
  cohort    PatientCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  patient   User          @relation("CohortMemberPatient", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([cohortId, patientId])
  @@index([patientId])
}

model OrganizationUserPermission {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("ORG_ADMIN")
  scopes         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model PatientLink {
  id               String           @id @default(uuid())
  clinicianId      String
  patientId        String
  relationshipType String           @default("PRIMARY")
  isActive         Boolean          @default(true)
  linkedAt         DateTime         @default(now())
  unlinkedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  clinician        ClinicianProfile @relation("ClinicianPatientLinks", fields: [clinicianId], references: [id], onDelete: Cascade)
  patient          User             @relation("PatientLinks", fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicianId, patientId])
  @@index([patientId, isActive])
}

model ConsentGrant {
  id             String           @id @default(uuid())
  patientId      String
  clinicianId    String
  scope          Json?
  status         ConsentStatus    @default(REQUESTED)
  grantedAt      DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  requestedScope Json?
  requestMessage String?
  responseReason String?
  requestedAt    DateTime         @default(now())
  respondedAt    DateTime?
  clinician      ClinicianProfile @relation("ClinicianConsents", fields: [clinicianId], references: [id], onDelete: Cascade)
  patient        User             @relation("PatientConsents", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([clinicianId, status])
}

model ScreeningDefinition {
  id                    String             @id @default(uuid())
  code                  String             @unique
  displayName           String
  domain                ScreeningDomain
  defaultIntervalMonths Int?
  minEligibleAge        Int?
  maxEligibleAge        Int?
  genderEligibility     GenderEligibility  @default(ALL)
  isActive              Boolean            @default(true)
  guidelineVersion      String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  dueItems              ScreeningDueItem[]
  plans                 ScreeningPlan[]
  records               ScreeningRecord[]
}

model ScreeningPlan {
  id                    String              @id @default(uuid())
  userId                String
  screeningDefinitionId String
  neverScreened         Boolean             @default(false)
  lastScreeningDate     DateTime?
  dataCalculated        Boolean             @default(false)
  source                PlanSource          @default(SYSTEM)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  dueItems              ScreeningDueItem[]
  screeningDefinition   ScreeningDefinition @relation(fields: [screeningDefinitionId], references: [id], onDelete: Cascade)
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, screeningDefinitionId])
  @@index([userId])
}

model ScreeningDueItem {
  id                    String              @id @default(uuid())
  userId                String
  screeningDefinitionId String
  screeningPlanId       String?
  dueDate               DateTime
  eligible              Boolean             @default(true)
  recommended           Boolean             @default(false)
  overdue               Boolean             @default(false)
  completed             Boolean             @default(false)
  completedAt           DateTime?
  intervalMonths        Int?
  calculationRunId      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  screeningDefinition   ScreeningDefinition @relation(fields: [screeningDefinitionId], references: [id], onDelete: Cascade)
  screeningPlan         ScreeningPlan?      @relation(fields: [screeningPlanId], references: [id])
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  screeningRecords      ScreeningRecord[]

  @@index([userId, completed, dueDate])
  @@index([screeningDefinitionId, dueDate])
}

model ScreeningRecord {
  id                     String                 @id @default(uuid())
  userId                 String
  screeningDefinitionId  String
  screeningDueItemId     String?
  recordedAt             DateTime               @default(now())
  performedAt            DateTime
  wasNormal              Boolean?
  outcomeStatus          ScreeningOutcomeStatus @default(PENDING)
  resultSummary          String?
  notes                  String?
  source                 RecordSource           @default(MOBILE_FORM)
  enteredByUserId        String?
  providerName           String?
  facilityName           String?
  legacyPayloadAvailable Boolean                @default(true)
  structuredData         Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  cancerDetail           CancerScreeningDetail?
  immunisationDetail     ImmunisationDetail?
  cardiovascularDetail   CardiovascularDetail?
  dentalDetail           DentalDetail?
  diabetesDetail         DiabetesDetail?
  mentalHealthDetail     MentalHealthDetail?
  attachments            ScreeningAttachment[]
  flags                  ScreeningFlag[]
  measurements           ScreeningMeasurement[]
  enteredByUser          User?                  @relation("ScreeningRecordEnteredBy", fields: [enteredByUserId], references: [id])
  screeningDefinition    ScreeningDefinition    @relation(fields: [screeningDefinitionId], references: [id], onDelete: Cascade)
  screeningDueItem       ScreeningDueItem?      @relation(fields: [screeningDueItemId], references: [id])
  user                   User                   @relation("ScreeningRecordOwner", fields: [userId], references: [id], onDelete: Cascade)
  visionDetail           VisionDetail?

  @@index([userId, performedAt])
  @@index([userId, screeningDefinitionId, performedAt])
  @@index([source, createdAt])
}

model ScreeningMeasurement {
  id                String             @id @default(uuid())
  screeningRecordId String
  code              String
  displayName       String?
  valueType         ScreeningValueType
  valueNumber       Decimal?           @db.Decimal(12, 4)
  valueText         String?
  valueBoolean      Boolean?
  valueDate         DateTime?
  valueCode         String?
  valueJson         Json?
  unit              String?
  referenceLow      Decimal?           @db.Decimal(12, 4)
  referenceHigh     Decimal?           @db.Decimal(12, 4)
  abnormalFlag      Boolean?
  interpretation    String?
  createdAt         DateTime           @default(now())
  screeningRecord   ScreeningRecord    @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)

  @@index([screeningRecordId, code])
  @@index([code, valueNumber])
  @@index([code, valueDate])
}

model ScreeningFlag {
  id                String          @id @default(uuid())
  screeningRecordId String
  severity          Severity
  code              String
  message           String
  createdAt         DateTime        @default(now())
  screeningRecord   ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)

  @@index([screeningRecordId, severity])
}

model ScreeningAttachment {
  id                String          @id @default(uuid())
  screeningRecordId String
  walletDocumentId  String?
  objectKey         String?
  fileName          String?
  mimeType          String?
  createdAt         DateTime        @default(now())
  screeningRecord   ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
  walletDocument    WalletDocument? @relation(fields: [walletDocumentId], references: [id])
}

model ScreeningImportBatch {
  id               String       @id @default(uuid())
  userId           String
  source           ImportSource
  status           ImportStatus @default(RUNNING)
  recordsAttempted Int          @default(0)
  recordsImported  Int          @default(0)
  errorCount       Int          @default(0)
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model CancerScreeningDetail {
  screeningRecordId   String                @id
  cancerType          CancerType
  testMethod          String?
  specimenType        String?
  specimenCollectedAt DateTime?
  labName             String?
  labReference        String?
  resultCategory      CancerResultCategory?
  followUpRequired    Boolean               @default(false)
  followUpBy          DateTime?
  recommendation      String?
  screeningRecord     ScreeningRecord       @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
}

model ImmunisationDetail {
  screeningRecordId      String             @id
  vaccineName            String
  vaccineType            VaccineType
  brand                  String?
  batchNumber            String?
  doseNumber             Int
  totalDoses             Int
  administrationSite     AdministrationSite
  providerName           String?
  clinic                 String?
  location               String?
  nextDueDate            DateTime?
  isOverdue              Boolean            @default(false)
  isDueSoon              Boolean            @default(false)
  seriesCompleted        Boolean            @default(false)
  seriesCompletedAt      DateTime?
  sideEffectsNone        Boolean            @default(true)
  sideEffectsMild        Boolean            @default(false)
  sideEffectsModerate    Boolean            @default(false)
  sideEffectsSevere      Boolean            @default(false)
  sideEffectsDescription String?
  isTravel               Boolean            @default(false)
  travelDestination      String?
  departureDate          DateTime?
  notes                  String?
  screeningRecord        ScreeningRecord    @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)

  @@index([vaccineName, nextDueDate])
  @@index([isOverdue, isDueSoon, nextDueDate])
}

model CardiovascularDetail {
  screeningRecordId String          @id
  systolicBp        Int?
  diastolicBp       Int?
  heartRate         Int?
  ecgResult         String?
  ecgNotes          String?
  totalCholesterol  Decimal?        @db.Decimal(8, 2)
  ldlCholesterol    Decimal?        @db.Decimal(8, 2)
  hdlCholesterol    Decimal?        @db.Decimal(8, 2)
  triglycerides     Decimal?        @db.Decimal(8, 2)
  screeningRecord   ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
}

model DiabetesDetail {
  screeningRecordId String          @id
  fastingGlucose    Decimal?        @db.Decimal(8, 2)
  randomGlucose     Decimal?        @db.Decimal(8, 2)
  postMealGlucose   Decimal?        @db.Decimal(8, 2)
  hba1c             Decimal?        @db.Decimal(5, 2)
  ketones           Decimal?        @db.Decimal(8, 2)
  systolicBp        Int?
  diastolicBp       Int?
  weightKg          Decimal?        @db.Decimal(8, 2)
  heightCm          Decimal?        @db.Decimal(8, 2)
  bmi               Decimal?        @db.Decimal(8, 2)
  notes             String?
  screeningRecord   ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
}

model VisionDetail {
  screeningRecordId       String          @id
  rightEyeAcuity          String?
  leftEyeAcuity           String?
  bothEyesAcuity          String?
  colorVisionResult       String?
  colorVisionDetails      String?
  peripheralVisionResult  String?
  peripheralVisionDetails String?
  rightEyePressure        Decimal?        @db.Decimal(8, 2)
  leftEyePressure         Decimal?        @db.Decimal(8, 2)
  blurredVision           Boolean         @default(false)
  eyeStrain               Boolean         @default(false)
  headaches               Boolean         @default(false)
  dryEyes                 Boolean         @default(false)
  nightVision             Boolean         @default(false)
  doubleVision            Boolean         @default(false)
  glassesOrContacts       String?
  notes                   String?
  screeningRecord         ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
}

model DentalDetail {
  screeningRecordId String          @id
  brushingFrequency String?
  flossingFrequency String?
  mouthwashUse      Boolean         @default(false)
  cavities          Int?
  fillings          Int?
  missingTeeth      Int?
  crowns            Int?
  implants          Int?
  gumBleeding       Boolean         @default(false)
  gumSwelling       Boolean         @default(false)
  gumRecession      Boolean         @default(false)
  gumSensitivity    Boolean         @default(false)
  toothache         Boolean         @default(false)
  jawPain           Boolean         @default(false)
  badBreath         Boolean         @default(false)
  dryMouth          Boolean         @default(false)
  grinding          Boolean         @default(false)
  toothSensitivity  Boolean         @default(false)
  lastCleaning      DateTime?
  lastXray          DateTime?
  orthodontics      String?
  smokingStatus     String?
  notes             String?
  screeningRecord   ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
}

model MentalHealthDetail {
  screeningRecordId     String          @id
  k10Score              Int?
  k10Level              String?
  dass21DepressionScore Int?
  dass21DepressionLevel String?
  dass21AnxietyScore    Int?
  dass21AnxietyLevel    String?
  dass21StressScore     Int?
  dass21StressLevel     String?
  sleepHours            Decimal?        @db.Decimal(5, 2)
  sleepQuality          String?
  difficultyFalling     Boolean         @default(false)
  frequentWaking        Boolean         @default(false)
  exerciseFrequency     String?
  socialSupport         String?
  workStress            String?
  substanceUse          Boolean         @default(false)
  persistentSadness     Boolean         @default(false)
  lossOfInterest        Boolean         @default(false)
  anxiousFeelings       Boolean         @default(false)
  irritability          Boolean         @default(false)
  concentrationProblems Boolean         @default(false)
  fatigueOrLowEnergy    Boolean         @default(false)
  notes                 String?
  screeningRecord       ScreeningRecord @relation(fields: [screeningRecordId], references: [id], onDelete: Cascade)
}

model PregnancyPlan {
  id                    String   @id @default(uuid())
  userId                String   @unique
  conceptionDate        DateTime
  expectedDueDate       DateTime
  estimatedCheckupDates Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletDocument {
  id                      String                @id @default(uuid())
  userId                  String
  title                   String
  description             String?
  documentType            String
  fileType                FileType
  objectKey               String?
  publicUrl               String?
  externalUrl             String?
  mimeType                String?
  sizeBytes               Int?
  legacyAppwriteStorageId String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  clinicianReviews        WalletDocumentReview[]
  screeningAttachments    ScreeningAttachment[]
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FeedbackEntry {
  id          String   @id @default(uuid())
  userId      String
  feedback    String
  rating      Int?
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
}

model ScreeningPracticeContact {
  id            String   @id @default(uuid())
  userId        String
  screeningName String?
  isDefault     Boolean  @default(false)
  hotdocUrl     String?
  practicePhone String?
  practiceEmail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, screeningName])
  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, screeningName])
}

model CancerScreeningSnapshot {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  age                      Int?
  gender                   Gender?
  calculatedScreeningDates Json?
  testResults              Json?
  lastScreeningDate        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthScreeningSnapshot {
  id              String    @id @default(uuid())
  userId          String    @unique
  age             Int?
  gender          Gender?
  checkupDates    Json?
  healthResults   Json?
  lastCheckupDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  status       String
  ipAddress    String?
  userAgent    String?
  meta         Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
}

model LegacyAppwriteMap {
  id                 String   @id @default(uuid())
  collectionName     String
  appwriteDocumentId String
  newRecordId        String
  migratedAt         DateTime @default(now())

  @@unique([collectionName, appwriteDocumentId])
}

